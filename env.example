# 复制本文件为 `.env` 后填写（`.env` 已在 .gitignore 中，勿提交）
# 密码中的 @ 等特殊字符在 DATABASE_URL 里需 URL 编码，例如 @ -> %40

# 监听地址（生产可写 0.0.0.0:8088，由前置 Nginx 做 HTTPS）
# BIND_ADDR=127.0.0.1:8088

# 生产部署时把 src/static 拷到服务器某目录并指向这里（不设则仅开发机路径有效）
# STATIC_DIR=/opt/actix-hd/static

# 签到地理围栏：**数据库表 geo_fence_config（singleton='x'）优先**；仅当读表失败或无记录时用下列变量兜底
# GEO_FENCE_LAT=31.1569
# GEO_FENCE_LNG=121.4746
# GEO_FENCE_RADIUS_KM=5
# GEO_FENCE_VENUE=上海东方体育中心

# 逆地理（签到页「大致位置」）：国内建议配置高德 Web 服务 Key（https://console.amap.com/）
# 未配置时尝试 OpenStreetMap，大陆机房常超时或被墙。
# AMAP_WEB_KEY=你的高德_Key

# 方式一（推荐）：
# DATABASE_URL=mysql://用户名:密码@主机:3306/数据库名?charset=utf8mb4

# 方式二：分项配置（程序会组装为连接串）
# DB_HOST=your-rds-host.mysql.rds.aliyuncs.com
# DB_PORT=3306
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_NAME=your_database
