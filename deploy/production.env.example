# 保存为服务器 /opt/actix-hd/.env ，chmod 600
# Actix 只监听本机，对外由 Nginx 80/443 反代（推荐）
BIND_ADDR=127.0.0.1:8088

STATIC_DIR=/opt/actix-hd/static

# 地理围栏：**表 geo_fence_config 优先**。仅读表失败时用下面变量兜底
# GEO_FENCE_LAT=31.1569
# GEO_FENCE_LNG=121.4746
# GEO_FENCE_RADIUS_KM=5
# GEO_FENCE_VENUE=上海东方体育中心

# 国内逆地理（签到页地址文案），高德控制台申请 Web 服务 Key
# AMAP_WEB_KEY=

# 数据库（二选一）
# DATABASE_URL=mysql://用户:密码@RDS内网或公网地址:3306/库名?charset=utf8mb4
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
